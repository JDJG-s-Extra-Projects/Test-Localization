{
    "convert_temperature": {
        "name": "온도_변환",
        "description": "특정 단위의 온도를 다른 온도 단위들로 변환시켜 줍니다.",
        "options": {
            "temperature_unit": {
                "name": "변환할_온도",
                "description": "다른 온도 단위로 변환시킬 온도 단위를 선택합니다.",
                "choices": [
                    "섭씨",
                    "화씨",
                    "절대온도(켈빈)",
                    "란씨(랭킨)"
                ]
            },
            "temperature": {
                "name": "온도",
                "description": "단위를 제외한 온도(숫자)를 입력해 주세요."
            }
        },
        "embeds": [
            {
                "title": "온도 변환됨",
                "fields": [
                    {
                        "name": "섭씨",
                        "value": "{temp_celsius} °C"
                    },
                    {
                        "name": "화씨",
                        "value": "{temp_fahrenheit} °F"
                    },
                    {
                        "name": "절대온도(켈빈)",
                        "value": "{temp_kelvin} K"
                    },
                    {
                        "name": "란씨(랭킨)",
                        "value": "{temp_rankine} °R"
                    }
                ],
                "footer": {
                    "text": "선택한 온도: {temperature_unit_value}"
                }
            }
        ],
        "translator_id": "622098032854433813"
    },
    "convert_speed": {
